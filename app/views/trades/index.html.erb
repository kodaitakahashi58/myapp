<h1>取引一覧</h1>

<%= link_to "新規登録", new_trade_path %>

<table>
  <thead>
    <tr>
      <th>銘柄名</th>
      <th>銘柄コード</th>
      <th>売買種別</th>
      <th>株数</th>
      <th>価格</th>
      <th>取引日</th>
    </tr>
  </thead>
  <tbody>
    <% @trades.each do |trade| %>
      <tr>
        <td><%= link_to trade.stock_name, trade_path(trade) %></td>
        <td><%= trade.stock_code %></td>
        <td><%= trade.buy? ? "買い" : "売り" %></td>
        <td><%= trade.shares %></td>
        <td><%= trade.price %></td>
        <td><%= trade.traded_on %></td>
      </tr>
    <% end %>
  </tbody>
</table>